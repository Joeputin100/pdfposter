<?xml version="1.0" encoding="utf-8"?>
<!--
  RC41: Manifest overlay applied only to the `benchmark` build variant.
  <profileable shell="true"> tells the OS to emit ATrace events for system
  tracing (which Macrobenchmark reads to compute StartupTimingMetric and
  FrameTimingMetric). Without this declaration the metrics come back empty.

  The release manifest can't carry this attribute because <profileable>
  with shell access leaks process-internal trace data, which we don't want
  in user-facing builds. Restricting it to the benchmark variant is the
  canonical Android pattern.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!--
          The previous draft had `tools:replace="android:debuggable"` on the
          <application> tag, which the manifest merger interprets as "I'm
          overriding android:debuggable here" — but no new value was given,
          so it failed with `tools:replace specified … but no new value
          specified`. The merger also ran on unit-test builds because the
          benchmark variant is part of every assemble pipeline, so the
          error broke far more than just the macrobench job.

          We don't actually need to override debuggable; the build.gradle.kts
          for the benchmark variant already sets isDebuggable = false. This
          overlay only contributes the <profileable> child element, which
          merges automatically.
        -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>
</manifest>
