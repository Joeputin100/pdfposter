<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Macrobenchmark module manifest — minimal. The benchmark installs a
      separate test APK that drives :app via UiAutomator, so it declares no
      Application class or activities of its own.

      RC73: WRITE_EXTERNAL_STORAGE intentionally NOT declared. Per Firebase
      Test Lab + Macrobenchmark guidance, it must be omitted on API 29+ —
      the library writes results via androidx.test.services TestStorage
      (no permission needed). Declaring it caused GrantPermissionRule to
      attempt `pm grant WRITE_EXTERNAL_STORAGE`, which fails on API 30+
      ("Failed to grant permissions") and aborted every benchmark.
    -->

</manifest>
